#!/usr/bin/env bash
set -euo pipefail

BEEBOT_ROOT="${BEEBOT_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)}"
export BEEBOT_ROOT

SOURCE_ROOT="$BEEBOT_ROOT/runtime/sources/slack-private"
export PYTHONPATH="$SOURCE_ROOT${PYTHONPATH:+:$PYTHONPATH}"

if command -v python_pwd >/dev/null 2>&1; then
  exec python_pwd -m slack_private.input
fi

exec python3 -m slack_private.input
