# Ignore deployment state by default; explicitly include source roots.
*

!*/

!/src/**
!/plugins/**
!/.claude-plugin/marketplace.json
!/.agents/
!/.agents/plugins/
!/.agents/plugins/marketplace.json
!/gateway/**
!/configs/**
!/templates/**
!/tests/**

!/inputs.d/README.md

!/.gitignore
!/README.md
!/pyproject.toml

# Re-ignore generated content swept in by the broad source rules.
/state_store/
/src/*.egg-info/
/build/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
