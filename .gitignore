# Ignore deployment state by default; explicitly include source roots.
*

!*/

!/src/**
!/tests/test_gateway.py
!/plugins/**
!/.claude-plugin/marketplace.json
!/.agents/
!/.agents/plugins/
!/.agents/plugins/marketplace.json

!/inputs.d/README.md
!/inputs.d/beeloop-timers
!/inputs.d/slack-private

# The Slack source is distributable code; its deployment data stays ignored.
!/runtime/sources/slack-private/README.md
!/runtime/sources/slack-private/SKILL.md
!/runtime/sources/slack-private/slack-private
!/runtime/sources/slack-private/slack_private/*.py

!/.gitignore
!/README.md
!/pyproject.toml

# Re-ignore generated content swept in by the broad source rules.
/state_store/
/src/*.egg-info/

__pycache__/
*.py[cod]
